# PostgreSQL（推荐）。密码按本机实际改。
# 本机免 sudo 实例默认 5433（D 盘二进制 + 家目录数据）
DATABASE_URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5433/it_ticket
# 若暂用 MySQL：mysql+aiomysql://root:123456@localhost:3306/it_ticket?charset=utf8mb4

# 阿里云百炼（通义千问 OpenAI 兼容）。真密钥只写 .env，不要提交。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Milvus（知识库向量）。管理页同步需显式配置 URI 或 HOST；检索脚本默认连本机 19530。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DB=rag_demo
MILVUS_COLLECTION=md
MILVUS_EMBED_DIM=1024

# 知识库多格式入库（可选）
# KB_UPLOAD_DIR=uploads/kb
# KB_MAX_UPLOAD_MB=20
# KB_VL_MODEL=qwen-vl-plus
# 配了 REDIS_URL 则入库进 Redis 列表，需另起 srcipts/kb_ingest_worker.py
# REDIS_URL=redis://127.0.0.1:6379/0
# KB_INGEST_REDIS_KEY=kb:ingest
